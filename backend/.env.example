# CyberShield AI — Environment Configuration Template
PROJECT_NAME="CyberShield AI"
VERSION="1.0.0"
ENVIRONMENT="production-hardened"
HOST="127.0.0.1"
PORT=8000
API_V1_STR="/api/v1"

# CORS Configuration: allow local Vite frontend and mobile clients
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database Configuration
DATABASE_URL="sqlite:///./data/cybershield.db"

# AI Inference & Security Settings
MAX_REQUEST_SIZE_BYTES=10485760
DEFAULT_CONFIDENCE_THRESHOLD=0.85
ENABLE_ML_MODELS=true
ENABLE_EXPLAINABLE_AI=true
LOG_LEVEL="INFO"
